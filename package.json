{
  "name": "deorch",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @deorch/web dev",
    "build": "pnpm --filter '@deorch/*' build",
    "lint": "pnpm --filter '@deorch/*' lint",
    "format": "pnpm --filter '@deorch/*' format",
    "typecheck": "pnpm --filter '@deorch/*' typecheck"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.7"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
