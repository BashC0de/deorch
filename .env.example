# DeOrch Environment Configuration
# Copy to .env and fill in values before running

# ── App ─────────────────────────────────────────────────────────────────────
DEORCH_ENV=development
DEORCH_SECRET_KEY=change-this-to-a-random-32-char-secret
DEORCH_DOMAIN=localhost

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./deorch.db
# PostgreSQL (for production or Docker setup)
# DATABASE_URL=postgresql+asyncpg://deorch:deorch@localhost:5432/deorch
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis (optional — only needed for multi-node deployments) ─────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Device Pairing ────────────────────────────────────────────────────────────
DEVICE_PAIRING_TOKEN_EXPIRE_SECONDS=300
DEVICE_PAIRING_MAX_ATTEMPTS=5

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MESSAGE_MAX_SIZE_BYTES=1048576

# ── Approval Requests ─────────────────────────────────────────────────────────
APPROVAL_REQUEST_DEFAULT_TTL_SECONDS=300
APPROVAL_REQUEST_MAX_TTL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ── Local Companion ───────────────────────────────────────────────────────────
COMPANION_API_URL=http://localhost:8000
COMPANION_WS_URL=ws://localhost:8000/ws/companion
COMPANION_DEVICE_ID=
COMPANION_DEVICE_SECRET=
COMPANION_SQLITE_PATH=./data/companion.db
COMPANION_HOOKS_PORT=8765

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
