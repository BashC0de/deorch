{
  "name": "@deorch/local-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "deorch": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "vitest": "^3.0.0"
  }
}
